---
import { ArrowRight, ArrowUpRight } from "@lucide/astro";
import type { Article } from "../lib/schema";
import { parseInterviewTitle } from "../lib/format";
import { articleSrcSet } from "../lib/media";
import { isExternalHref } from "../lib/url";
import TypeChip from "./TypeChip.astro";

interface Props {
  article: Article;
  priority?: boolean;
}

const { article, priority = false } = Astro.props;
const parsed = parseInterviewTitle(article.title);
const displayTitle = parsed.name || article.title;
const external = isExternalHref(article.href);
const Arrow = external ? ArrowUpRight : ArrowRight;
---

<article class="interview-card group">
  <a
    href={article.href}
    class="block"
    {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
  >
    <div class="relative aspect-[4/5] overflow-hidden bg-line">
      <img
        src={article.image}
        srcset={articleSrcSet(article.image)}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        alt={article.title}
        width={article.imageWidth}
        height={article.imageHeight}
        class="size-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.03]"
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/20 to-transparent opacity-90"></div>

      <div class="absolute left-3 top-3">
        <TypeChip article={article} />
      </div>

      <div class="absolute inset-x-3 bottom-3">
        {parsed.company && (
          <span class="label mb-2 inline-block rounded-full bg-white px-3 py-1.5 text-ink">
            {parsed.company}
          </span>
        )}
        <h3
          class:list={[
            "display text-balance text-gold",
            parsed.name
              ? "text-[clamp(1.9rem,4vw,3.1rem)]"
              : "line-clamp-4 text-[clamp(1.35rem,2.8vw,2rem)]",
          ]}
        >
          {displayTitle}
        </h3>
        {parsed.name && parsed.quote && (
          <p class="serif mt-2 line-clamp-2 text-sm leading-snug text-white/80">
            «{parsed.quote}»
          </p>
        )}
      </div>

      <span class="absolute right-3 top-3 flex size-9 items-center justify-center rounded-full bg-lemon text-ink opacity-0 transition-opacity group-hover:opacity-100">
        <Arrow size={16} stroke-width={2} aria-hidden="true" />
      </span>
    </div>
  </a>
</article>
