---
import { ArrowUpRight } from "@lucide/astro";

interface Props {
  platform: string;
  handle: string;
  description: string;
  href: string;
  accent: string;
  note?: string;
}

const { platform, handle, description, href, accent, note } = Astro.props;
---

<header class="mb-8 border-b-2 border-ink">
  <div class:list={["-mx-5 px-5 py-6 lg:-mx-8 lg:px-8 lg:py-8", accent]}>
    <h1 class="display text-[clamp(3.4rem,9vw,7.5rem)]">{platform}</h1>
  </div>

  <div class="grid gap-5 py-5 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-8">
      <p class="label text-muted">Cuenta oficial / {handle}</p>

      <p class="serif mt-3 max-w-2xl text-lg leading-snug text-ink/75 lg:text-xl">
        {description}
      </p>

      {note && (
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">
          {note}
        </p>
      )}
    </div>

    <div class="lg:col-span-4 lg:flex lg:justify-end">
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        class="label hover-arrow inline-flex items-center gap-3 border-2 border-ink bg-ink px-5 py-3 text-paper transition-colors hover:bg-green"
      >
        Seguir en {platform}
        <ArrowUpRight size={15} stroke-width={2} class="arrow" aria-hidden="true" />
      </a>
    </div>
  </div>
</header>
