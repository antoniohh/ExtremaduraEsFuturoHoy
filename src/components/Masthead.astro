---
import { Menu, Search } from "@lucide/astro";
import { NAV, SITE, SOCIAL_LINKS } from "../lib/site";
import { formatBuildTime, formatLongDate } from "../lib/format";
import { syncStatus } from "../lib/data";
import Ticker from "./Ticker.astro";

const today = formatLongDate(new Date().toISOString());
const updated = formatBuildTime(syncStatus.generatedAt);
---

<header class="relative z-40 border-b border-ink/15 bg-paper" data-pagefind-ignore>
  <div class="hidden border-b border-ink/10 lg:block">
    <div class="mx-auto flex max-w-[1280px] items-center justify-between px-8 py-1.5">
      <p class="label text-muted">{today}</p>
      <p class="label text-muted">Actualizado · {updated}</p>
    </div>
  </div>

  <div class="mx-auto flex max-w-[1280px] items-center justify-between gap-6 px-5 py-3.5 lg:px-8">
    <a href="/" class="shrink-0" aria-label={`${SITE.name} · Inicio`}>
      <img
        src="/logo-header.webp"
        alt={SITE.name}
        width="400"
        height="118"
        class="h-9 w-auto lg:h-12"
      />
    </a>

    <nav class="hidden items-center gap-5 lg:flex" aria-label="Navegación principal">
      {NAV.map((item) => (
        <a
          href={item.href}
          class="label u-link py-1 transition-colors hover:text-green"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/buscar/"
        class="flex size-10 items-center justify-center rounded-full border border-ink/20 transition-colors hover:border-ink hover:bg-lemon"
        aria-label="Buscar en el sitio"
      >
        <Search size={17} stroke-width={1.8} aria-hidden="true" />
      </a>

      <details class="relative lg:hidden">
        <summary
          class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full border border-ink/20 transition-colors hover:border-ink hover:bg-lemon"
          aria-label="Abrir menú"
        >
          <Menu size={18} stroke-width={1.8} aria-hidden="true" />
        </summary>
        <div class="absolute right-0 top-[calc(100%+0.6rem)] z-50 w-72 border-2 border-ink bg-paper p-4">
          <nav class="flex flex-col" aria-label="Navegación móvil">
            {NAV.map((item) => (
              <a
                href={item.href}
                class="u-link border-b border-line py-3 font-sans text-sm font-semibold uppercase tracking-[0.08em] last:border-b-0 hover:text-green"
              >
                {item.label}
              </a>
            ))}
            <a
              href="/sobre-el-proyecto/"
              class="u-link border-b border-line py-3 font-sans text-sm font-semibold uppercase tracking-[0.08em] hover:text-green"
            >
              Sobre el proyecto
            </a>
          </nav>
          <div class="mt-4 flex gap-3 border-t border-line pt-4">
            {SOCIAL_LINKS.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="label u-link text-muted hover:text-ink"
              >
                {link.short}
              </a>
            ))}
          </div>
        </div>
      </details>
    </div>
  </div>

  <Ticker />
</header>
