---
import { ArrowUpRight } from "@lucide/astro";
import type { SocialPost } from "../lib/schema";
import { formatDate } from "../lib/format";

interface Props {
  post: SocialPost;
}

const { post } = Astro.props;
const labels = {
  instagram: "Instagram",
  youtube: "YouTube",
  tiktok: "TikTok",
} as const;
const colors = {
  instagram: "bg-magenta",
  youtube: "bg-cyan",
  tiktok: "bg-green",
} as const;
---

<a
  href={post.url}
  target="_blank"
  rel="noopener noreferrer"
  class="group block"
>
  <div class="relative aspect-[4/5] overflow-hidden border border-ink/10 bg-line">
    <img
      src={post.image}
      alt={post.caption}
      class="size-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
      loading="lazy"
    />
    <span class="label absolute left-2 top-2 inline-flex items-center gap-1.5 bg-ink px-2 py-1 text-paper">
      <span class:list={["size-1.5 rounded-full", colors[post.platform]]} aria-hidden="true"></span>
      {labels[post.platform]}
    </span>
    <div class="absolute inset-0 flex items-end bg-ink/0 p-3 opacity-0 transition-all duration-300 group-hover:bg-ink/60 group-hover:opacity-100">
      <span class="label flex items-center gap-2 text-paper">
        Ver publicación
        <ArrowUpRight size={14} stroke-width={2} aria-hidden="true" />
      </span>
    </div>
  </div>

  <div class="mt-3 flex items-start justify-between gap-3">
    <p class="line-clamp-2 text-sm font-semibold leading-snug u-link">{post.caption}</p>
    <span class="label shrink-0 text-muted">{formatDate(post.date)}</span>
  </div>
</a>
