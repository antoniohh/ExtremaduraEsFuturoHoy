---
import { ArrowRight, ArrowUpRight } from "@lucide/astro";

interface Props {
  href: string;
  label: string;
  external?: boolean;
  className?: string;
  tone?: "ink" | "paper";
}

const {
  href,
  label,
  external = false,
  className = "",
  tone = "ink",
} = Astro.props;

const Icon = external ? ArrowUpRight : ArrowRight;
---

<a
  href={href}
  class:list={[
    "label group inline-flex items-center gap-3 transition-colors",
    tone === "paper" ? "text-paper hover:text-lemon" : "text-ink hover:text-green",
    className,
  ]}
  {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
>
  <span class="u-link">{label}</span>
  <span
    class:list={[
      "flex size-8 items-center justify-center rounded-full border-2 border-current transition-transform duration-300 group-hover:translate-x-1",
      tone === "paper" ? "bg-transparent" : "bg-lemon",
    ]}
  >
    <Icon size={15} stroke-width={2} aria-hidden="true" />
  </span>
</a>
