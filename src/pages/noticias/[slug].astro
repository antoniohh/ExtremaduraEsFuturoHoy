---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import TypeChip from "../../components/TypeChip.astro";
import ArticleMeta from "../../components/ArticleMeta.astro";
import NewsRow from "../../components/NewsRow.astro";
import ArrowLink from "../../components/ArrowLink.astro";
import { archive, articles } from "../../lib/data";
import { articleSchema, breadcrumbSchema } from "../../lib/seo";
import { truncate, formatDate } from "../../lib/format";
import { KIND_LABEL } from "../../lib/site";

export function getStaticPaths() {
  return archive.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const related = articles
  .filter((item) => item.kind === article.kind && item.id !== article.id)
  .slice(0, 4);

const jsonLd = [
  articleSchema(article),
  breadcrumbSchema([
    { name: "Inicio", path: "/" },
    { name: "Noticias", path: "/noticias/" },
    { name: article.title, path: article.href },
  ]),
];
---

<BaseLayout
  title={article.title}
  description={truncate(article.excerpt, 155)}
  image={article.image}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-[1280px] px-5 py-8 lg:px-8 lg:py-12">
    <Breadcrumbs
      items={[
        { name: "Inicio", href: "/" },
        { name: "Noticias", href: "/noticias/" },
        { name: article.title, href: article.href },
      ]}
    />

    <article class="mt-8">
      <header class="grid gap-8 border-b-2 border-ink pb-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-7">
          <div class="flex flex-wrap items-center gap-3">
            <TypeChip article={article} />
            <span class="sticker">Archivo</span>
            <span class="label text-muted">{article.categories.join(" · ")}</span>
          </div>
          <h1 class="display mt-5 text-[clamp(2.7rem,5.8vw,5.4rem)]">
            {article.title}
          </h1>
          {article.excerpt && (
            <p class="serif mt-5 max-w-2xl text-lg leading-snug text-ink/75 lg:text-xl">
              {article.excerpt}
            </p>
          )}
          <div class="mt-6">
            <ArticleMeta article={article} />
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative aspect-[3/2] overflow-hidden bg-line">
            <img
              src={article.image}
              alt={article.title}
              width={article.imageWidth}
              height={article.imageHeight}
              class="size-full object-cover"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </header>

      <div class="grid gap-10 py-10 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-8">
          <div class="archive-prose" set:html={article.contentHtml} />

          {related.length > 0 && (
            <div class="mt-12 border-t-2 border-ink pt-6">
              <h2 class="display text-4xl">Sigue leyendo</h2>
              <div class="mt-2">
                {related.map((item) => (
                  <NewsRow article={item} />
                ))}
              </div>
            </div>
          )}
        </div>

        <aside class="lg:col-span-4">
          <div class="border-2 border-ink bg-lemon p-6 lg:sticky lg:top-8">
            <p class="label">Ficha de archivo</p>
            <dl class="mt-4 space-y-3 text-sm">
              <div>
                <dt class="label text-ink/60">Fecha</dt>
                <dd class="mt-0.5 font-semibold">{formatDate(article.publishedAt)}</dd>
              </div>
              <div>
                <dt class="label text-ink/60">Tipo</dt>
                <dd class="mt-0.5 font-semibold">{KIND_LABEL[article.kind]}</dd>
              </div>
              <div>
                <dt class="label text-ink/60">Categoría</dt>
                <dd class="mt-0.5 font-semibold">{article.categories.join(" · ")}</dd>
              </div>
              <div>
                <dt class="label text-ink/60">Autoría</dt>
                <dd class="mt-0.5 font-semibold">{article.authorName}</dd>
              </div>
            </dl>

            <div class="mt-6 flex flex-col gap-3">
              <ArrowLink href="/noticias/" label="Volver a noticias" />
              <p class="label border-t border-ink/20 pt-3 text-ink/60">
                Pieza recuperada del archivo original
              </p>
            </div>
          </div>
        </aside>
      </div>
    </article>
  </div>
</BaseLayout>
